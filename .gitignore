# Generated by Cargo
# will have compiled files and executables

debug/
target/
.env*/**

# Git stuff
.worktrees

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
dump.rdb
.env
python/.env*
benchmarks/results

# Python byte-compiled files
__pycache__/
*.py[cod]

# IDE generaged files
.vs
.vscode
.idea

# MacOS metadata
.DS_Store

node_modules/

install_and_test_cp.sh

glide-logs/
logger-rs.linux-x64-gnu.node
utils/clusters/
utils/tls_crts/
utils/TestUtils.js
# ORT attribution step writes these package lists into utils/ (get_licenses_from_ort.py)
utils/*_package_list.txt
.build/
.project

# OSS Review Toolkit (ORT) files
**/ort*/**
**/ort_results/**
# The ORT tool is checked out at ./ort as a nested git repo; git reports that as a
# lone `ort/` entry that the contents-matching `**/ort*/**` above cannot suppress.
/ort/

# java compiled files.
*.class

# generaged files (e.g. protobuf)
generated/
protoc-*.zip

# compiled binaries
*.dylib
*.so
*.dll


# docs
docs/markdown/node/**
docs/site/**
copilot.yml
memory-bank/
#cpp files
cpp/benchmarks/build/
cpp/build/
cpp/examples/build/
cpp/include/glide/connection_request.pb.h

cpp/include/glide/glide_base.h
cpp/src/connection_request.pb.cc

**/.claude/settings.local.json
copilot-instructions.md
**/.yarn

# AI agent related files
.kiro/
.cursor/
**/bench-results*
**/benchmark_checkpoint*
**/polyglot-benchmarks/
**/performance*
*.pyc
__pycache__/
test-report*.html
node/test-report*.html
# redis-rs CI steps tee their output into the worktree (bench-results* is above)
**/test-output.log
**/audit-results.txt
**/machete-results.txt
