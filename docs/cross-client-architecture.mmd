    note["<b>Diagram overview</b><br/><br/>Client configuration flows through each language's native bridge and converges on glide-core's native types.<br/><br/>Most clients use the shared ConnectionRequest schema. Ruby enters shared FFI as URI + JSON, C# uses its own C-layout ABI, and Rust constructs core types directly."]

    python -->|"generated protobuf config"| ffi
    go -->|"generated protobuf config"| ffi
    php -->|"protobuf-c config"| ffi
    
    java -->|"generated protobuf config"| jni
    node -->|"protobufjs config"| napi
    csharp -->|"builds managed layouts"| csharp_ffi
    rust -->|"typed Rust config; no serialization"| core_types

    config_schema -.->|"generated config types"| ffi
    config_schema -.->|"generated config types"| jni
    config_schema -.->|"generated config types"| napi

    command_ids -.->|"command discriminator"| ffi
    command_ids -.->|"command discriminator"| jni
    command_ids -.->|"command discriminator"| napi
    command_ids -.->|"⚠️ manually mirrored numeric IDs"| csharp_types

    csharp_types -.->|"layout-coupled ABI"| csharp_ffi

    ffi -->|"parse or build protobuf; normalize"| core_types
    jni -->|"decode protobuf; normalize"| core_types
    napi -->|"decode protobuf; normalize"| core_types
    csharp_ffi -->|"constructs directly; no protobuf"| core_types
    core_types --> core
    core ~~~ note

